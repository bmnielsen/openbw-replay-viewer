{
  "applicationId": "io.github.dgant.replayviewer",
  "applicationName": "StarCraft Replay Viewer",
  "description": "StarCraft Replay Viewer",
  "version": "0.1.0",
  "defaultMode": "window",
  "documentRoot": "/www/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "dataLocation": "system",
  "storageLocation": "system",
  "nativeAllowList": [
    "app.*",
    "filesystem.createDirectory",
    "filesystem.getStats",
    "filesystem.readBinaryFile",
    "storage.getData",
    "storage.getKeys",
    "storage.setData",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "StarCraft Replay Viewer",
      "width": 1440,
      "height": 960,
      "minWidth": 960,
      "minHeight": 640,
      "center": true,
      "exitProcessOnClose": false,
      "useSavedState": false,
      "icon": "/www/icon.png"
    }
  },
  "cli": {
    "binaryName": "replay-viewer-desktop",
    "resourcesPath": "/www/",
    "resourcesExclude": ".*\\.rep$",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/www/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  }
}
